{
  "name": "jarvis-agents",
  "productName": "JARVIS",
  "version": "1.3.0",
  "description": "JARVIS — a local desktop app where Claude builds and Codex tests your code",
  "author": "JARVIS",
  "main": "desktop/main.js",
  "bin": {
    "jarvis": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "design": "node design/build.cjs && node design/skins.cjs",
    "assets": "electron design/make-assets.cjs",
    "dist": "node design/build.cjs && node design/skins.cjs && electron design/make-assets.cjs && electron-builder --win --x64",
    "test": "node --test test/orchestrator.test.js test/regressions.test.js test/limit.test.js test/providers.test.js test/features.test.js test/extensions.test.js test/voice.test.js test/offline.test.js test/cc.test.js test/talks.test.js test/bot.test.js",
    "release": "npm version patch -m \"release v%s\" && git push --follow-tags"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "jarvis": {
    "allowClaudeAiLogin": false
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "onnxruntime-web": "^1.22.0"
  },
  "build": {
    "appId": "app.jarvis.agents",
    "productName": "JARVIS",
    "copyright": "JARVIS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "review-schema.json",
      "package.json",
      "lib/**/*",
      "desktop/**/*",
      "public/**/*"
    ],
    "asarUnpack": [
      "review-schema.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "JARVIS-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "borhanslm",
        "repo": "jarvis-agents",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/borhanslm/jarvis-agents.git"
  }
}
